; generated/ holds the output of Extract.v and the kernel's printer; it is
; rebuilt by make and never edited by hand.
(copy_files generated/{deptypes.ml,deptypes.mli,pretty.ml})

(library
 (name deptypes)
 (wrapped false)
 (modules deptypes)
 (flags (:standard -w -a)))

(library
 (name deptypes_pretty)
 (wrapped false)
 (modules pretty pretty_ind)
 (libraries deptypes))

(executable
 (name main)
 (modules main)
 (libraries deptypes deptypes_pretty))

(test
 (name regress)
 (modules regress)
 (libraries deptypes deptypes_pretty))
